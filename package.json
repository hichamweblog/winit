{
  "name": "winit",
  "version": "0.1.0",
  "private": true,
  "description": "Winit — نظام إنتاجية عربي متكامل مستوحى من TickTick، جاهز للتوسع إلى SaaS متعدد المستخدمين",
  "scripts": {
    "dev": "npm run db:push && npm run db:seed && next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "rm -f data/winit.db && npm run db:push && npm run db:seed",
    "test": "tsx --test src/lib/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/readex-pro": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.70.0",
    "next": "15.5.29",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
