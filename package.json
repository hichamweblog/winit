{
  "name": "winit",
  "version": "0.1.0",
  "private": true,
  "description": "Winit — نظام إنتاجية عربي متكامل مستوحى من TickTick، جاهز للتوسع إلى SaaS متعدد المستخدمين",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:setup": "npm run db:migrate && npm run db:seed",
    "build:migrate": "esbuild src/db/migrate.ts --bundle --platform=node --format=esm --outfile=scripts/migrate.mjs --external:better-sqlite3",
    "build": "npm run build:migrate && next build",
    "start": "next start -H 0.0.0.0",
    "bootstrap": "node scripts/bootstrap.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:backup": "node scripts/backup.mjs",
    "db:reset": "node scripts/reset.mjs",
    "sessions:purge": "tsx src/db/purge-sessions.ts",
    "test": "tsx --test src/lib/*.test.ts src/lib/server/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:design": "node scripts/design-system-gate.mjs",
    "check": "npm run typecheck && npm test && npm run test:design",
    "test:api": "node scripts/api-smoke.mjs",
    "db:clean-demo": "node scripts/clean-demo.mjs"
  },
  "dependencies": {
    "@fontsource/el-messiri": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/readex-pro": "^5.3.0",
    "@tabler/icons-react": "^3.50.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "15.5.29",
    "react": "19.2.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "8.5.32"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.2"
}
