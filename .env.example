# ---------------------------------------------------------------------------
# Winit configuration. Copy to .env.local for development.
# Every value below is optional; the defaults are safe for local use.
# ---------------------------------------------------------------------------

# SQLite file. `file:` prefix is accepted and stripped.
# Production: point this at a persistent volume, never at the container layer.
DATABASE_URL=./data/winit.db

# Public origin as the browser sees it, e.g. https://winit.example.com
# Required behind a reverse proxy so the same-origin check accepts your domain.
# WINIT_PUBLIC_ORIGIN=https://winit.example.com

# Set to 1 only when the app sits behind a trusted proxy that sets
# X-Forwarded-For. Otherwise rate limiting would trust a spoofable header.
# WINIT_TRUST_PROXY=1

# Set to 1 to serve plain-HTTP previews with production builds.
# Leave unset on any HTTPS deployment so session cookies stay Secure.
# WINIT_INSECURE_COOKIES=1

# *** DANGER *** Shared, passwordless, PUBLIC scratch workspace for anonymous
# visitors. For demos and previews only. Never enable where real data lives.
# WINIT_DEMO_MODE=1

# Escape hatch for seeding a production database. You almost certainly do not
# want this; `npm run db:seed` refuses to run in production without it.
# WINIT_ALLOW_PRODUCTION_SEED=1
